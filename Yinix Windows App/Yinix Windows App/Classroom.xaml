<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Yinix_Windows_App.Classroom"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Yinix_Windows_App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#f6f7f9">
        <!-- Side Bar -->
        <StackPanel Style="{StaticResource Outline}" Width="230"
x:Name="YinixNavBar" HorizontalAlignment="Left"
BorderThickness="0,0,3,0" Padding="10,30,10,10"
 CornerRadius="0">
            <Button Style="{StaticResource Navbar-Item-Active}" x:Name="NavBarHome" Click="NavigateToHome">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="/Assets/Icons/house-simple-bold.svg" Style="{StaticResource Navbar-Icon}" />
                    <TextBlock Style="{StaticResource Navbar-Label}">Home</TextBlock>
                </StackPanel>
            </Button>

            <Button x:Name="NavBarWork" Style="{StaticResource Navbar-Item}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="/Assets/Icons/clipboard-text-bold.svg" Style="{StaticResource Navbar-Icon}" />
                    <TextBlock Style="{StaticResource Navbar-Label}" VerticalAlignment="Center">Work</TextBlock>
                </StackPanel>
            </Button>

            <Button x:Name="NavBarSettings" Style="{StaticResource Navbar-Item}" Click="NavigateToSettings">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="/Assets/Icons/gear-six-bold.svg" Style="{StaticResource Navbar-Icon}" />
                    <TextBlock Style="{StaticResource Navbar-Label}" VerticalAlignment="Center">Settings</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Top Bar -->
        <StackPanel Style="{StaticResource Outline}" Canvas.ZIndex="-1" Height="100" VerticalAlignment="Top"
BorderThickness="0,0,0,2" CornerRadius="0" HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Right" Margin="0,27,20,0" VerticalAlignment="Center"
    Orientation="Horizontal">
                <Button Style="{StaticResource No-BG-Button}" Click="Navigate_Back">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Icons/caret-left-bold.svg" Height="20"></Image>
                        <TextBlock Margin="9,0,0,0">Back</TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource No-BG-Button}">
                    <Image Source="/Assets/Icons/list-bold.svg" Height="20"></Image>
                </Button>
                <PersonPicture Initials="PO" Width="36"></PersonPicture>
            </StackPanel>
        </StackPanel>


        <!-- Main Content -->
        <StackPanel x:Name="MainContent" Margin="270,150,0,0" Orientation="Vertical"
        Spacing="20">
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Title}">Ms. Cook 5-34</TextBlock>
            <Line Stroke="Black" StrokeThickness="3" X1="20" X2="400"
                  HorizontalAlignment="Center" Margin="0,0,0,32"></Line>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border BorderBrush="#e0e4eb" BorderThickness="3"
                 CornerRadius="25" Width="300" Margin="0,0,10,0">
                    <RichEditBox PlaceholderText="Create an Announcement..."  x:Name="AnnouncementTextBox"></RichEditBox>
                </Border>
                <Button Click="SubmitAnnouncement">Send</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
